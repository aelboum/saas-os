# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored -- never commit it. No value below is a real secret.
# See docs/ADR/0012-secrets-management.md and docs/SECURITY.md section 4.
#
# Production (docker-compose.prod.yml) splits these settings in two
# (ADR-0012 amendment of 2026-10-21): the application's settings go in
# `.env.app` (template `.env.app.example`), loaded only into `backend` and
# `worker`; `.env` keeps only what Compose substitutes into the file --
# the domains, IDENTITY_PROFILE and every ZITADEL_ value -- and is loaded
# into no service. docs/RUNBOOKS.md, "Production configuration files".

ENVIRONMENT=development

# --- Database (docs/ADR/0002-multi-tenancy-isolation-model.md) -----------
# Two distinct roles (docs/IMPLEMENTATION-ROADMAP.md Phase 3.1 security
# correction): POSTGRES_USER is the bootstrap/superuser role Postgres
# itself creates -- used only for migrations, never by the running
# application. APP_DB_USER is a restricted, NOSUPERUSER/NOBYPASSRLS role
# (created by saas_os/infra/db/init/01-create-app-role.sh on first boot) that
# DATABASE_URL points at -- the role Row-Level Security enforcement
# depends on actually being non-superuser.
POSTGRES_USER=saas_os
POSTGRES_PASSWORD=changeme
POSTGRES_DB=saas_os
APP_DB_USER=saas_os_app
APP_DB_PASSWORD=changeme_app
DATABASE_URL=postgresql+psycopg://saas_os_app:changeme_app@db:5432/saas_os
MIGRATIONS_DATABASE_URL=postgresql+psycopg://saas_os:changeme@db:5432/saas_os
# Platform-configuration role (docs/ADR/0056-platform-configuration-database-identity.md):
# the only role that may write the global AI configuration. Its name may be
# set here; migrations read it. Its password and PLATFORM_CONFIG_DATABASE_URL
# must NOT be set in this file: backend and worker load it and refuse to start
# if they see either. Give them only to the `saas-os-operator ai-*` command
# that changes AI configuration (docs/RUNBOOKS.md, "AI configuration role").
PLATFORM_CONFIG_DB_USER=saas_os_platform_config
# DB_REQUIRE_TLS (S-05, docs/ADR/0021-database-redis-transport-encryption.md):
# optional. Defaults to true when ENVIRONMENT=production, false otherwise --
# leave unset here. When true, both DATABASE_URL/MIGRATIONS_DATABASE_URL
# must already specify sslmode=require (or stronger), or saas_os/infra/db/config.py
# adds it automatically; a URL explicitly specifying a weaker sslmode
# (disable/allow/prefer) fails closed at startup instead of connecting in
# plaintext. This repository's own docker-compose.prod.yml does NOT set
# DB_REQUIRE_TLS=false -- it relies on this default; only set it here if a
# specific deployment has its own reviewed reason to opt out (see the ADR).
# DB_REQUIRE_TLS=true

# --- Redis / background jobs (docs/ADR/0007-...) --------------------------
# REDIS_URL is read through the active SecretsProvider by both the API and
# the worker (`python -m saas_os.api.worker`, P2.1 -- the process that executes
# queued jobs). JOBS_MAX_TRIES / JOBS_RETRY_BACKOFF_BASE_SECONDS are the
# optional, non-secret retry-policy tunables (saas_os/infra/jobs/config.py);
# omitted here, they default to 3 and 1.0.
REDIS_URL=redis://redis:6379/0
# REDIS_REQUIRE_TLS (S-05): the same DB_REQUIRE_TLS decision, for Redis --
# optional, defaults to true when ENVIRONMENT=production. When true,
# REDIS_URL must use the rediss:// scheme (not redis://); there is no
# in-URL parameter to add automatically for Redis, so a redis:// URL fails
# closed at startup instead of connecting in plaintext.
# REDIS_REQUIRE_TLS=true

# --- Identity: OIDC (docs/ADR/0005-...; docs/ADR/0023-... Phase 2) --------
# OIDC_ISSUER_URL / OIDC_CLIENT_ID are read through the SecretsProvider
# (saas_os/core/identity/provider.py); the authorization/token/JWKS endpoints are
# discovered from the issuer's standard /.well-known/openid-configuration,
# never hard-coded. SaaS-OS identity reads only these provider-neutral
# names -- OIDC is the protocol boundary; the specific issuer these point
# at determines the actual provider. OIDC_CLIENT_SECRET is optional: leave
# it empty for a client registered as a *public* client (the login flow
# then relies on PKCE S256 alone, which is always required regardless);
# set it for a confidential client. It is only ever sent in the
# server-side token exchange (saas_os/core/identity/oidc.py::exchange_authorization_code).
#
# Phase 2 cutover: the pre-Phase-2 ZITADEL_ISSUER_URL / ZITADEL_CLIENT_ID /
# ZITADEL_CLIENT_SECRET names are no longer read by saas_os/core/identity at all --
# setting one of those alongside its OIDC_* replacement is a fail-closed
# configuration error (saas_os/core/identity/provider.py::_reject_if_both_set),
# never silent precedence either way. ZITADEL server configuration
# (ZITADEL_MASTERKEY, ZITADEL_EXTERNALDOMAIN, etc., further down) is
# unrelated -- that configures the ZITADEL deployment itself, not
# SaaS-OS's own OIDC relying-party boundary.
#
# The default below points at the local, self-hosted ZITADEL that
# `docker compose up` now starts (docs/ADR/0023-..., "Local self-hosted
# ZITADEL" section further down) -- no ZITADEL Cloud account or other
# external provider is required for local development. `zitadel.localhost`
# (not plain `localhost`) is required: it's the one hostname reachable both
# from your browser (the reserved .localhost TLD resolves to 127.0.0.1 with
# no /etc/hosts entry needed) and from other containers (docker-compose.yml
# gives the `zitadel` service that exact same string as a network alias) --
# see the `zitadel` service's own comments for why that split matters.
# OIDC_CLIENT_ID is intentionally left blank: ZITADEL assigns it when
# the `zitadel-bootstrap` service creates the local OIDC application
# (deterministic name, but a provider-assigned numeric id), so it cannot be
# a fixed placeholder here -- run `docker compose logs zitadel-bootstrap`
# after first `docker compose up` and copy the printed
# `OIDC_CLIENT_ID=...` value into this file. Point these three at a
# different (e.g. cloud-hosted) OIDC-compliant provider instead if you
# don't want to use the local ZITADEL one.
OIDC_ISSUER_URL=http://zitadel.localhost:8081
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Local self-hosted ZITADEL (docs/ADR/0023-..., Phase 1) ----------------
# Configuration for the `zitadel`/`zitadel-db`/`zitadel-bootstrap` services
# in docker-compose.yml -- the local identity provider itself, not SaaS-OS's
# own consumer-side config above. Dedicated PostgreSQL database/credentials,
# never the SaaS-OS `db`/`APP_DB_USER` -- ZITADEL manages its own schema and
# must never be added to SaaS-OS's Alembic migration history (ADR-0023 S5).
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=changeme_zitadel_db
ZITADEL_DB_NAME=zitadel
# Must be exactly 32 characters -- ZITADEL uses this to encrypt data at
# rest and refuses to start otherwise. Changing or losing it after first
# startup makes that instance's encrypted data permanently unreadable (the
# instance is local/disposable, so for this environment that just means
# `docker compose down -v` and re-bootstrapping -- see docs/LOCAL-IDENTITY.md).
# Generate your own with: openssl rand -hex 16
ZITADEL_LOCAL_MASTERKEY=f9535fcdd55dbb8e22bc12e69834d575
# Host port the local ZITADEL is published on (developer/browser access and
# the OIDC authorization-redirect leg both need this reachable from the
# host, not just from other containers -- see docs/LOCAL-IDENTITY.md).
# Never published in docker-compose.prod.yml.
ZITADEL_LOCAL_PORT=8081
# Optional names `zitadel-bootstrap` (`saas-os-local-identity`) gives the
# local ZITADEL project and OIDC application. Left commented out, SaaS-OS's
# own defaults apply (`saas-os` / `saas-os-backend`); a consuming project
# sets its own. Non-secret. See docs/LOCAL-IDENTITY.md.
# OIDC_LOCAL_PROJECT_NAME=saas-os
# OIDC_LOCAL_APPLICATION_NAME=saas-os-backend
# The initial admin console login (http://localhost:8081/ui/console) --
# local-only, not used by SaaS-OS's own OIDC flow.
ZITADEL_FIRSTINSTANCE_ADMIN_USERNAME=admin
# Must satisfy ZITADEL's default password complexity policy (upper + lower
# + digit, minimum length) -- verified empirically: a plain lowercase
# placeholder like `changeme` is rejected outright (setup fails with
# `Errors.User.PasswordComplexityPolicy.HasUpper`) rather than accepted and
# flagged later.
ZITADEL_FIRSTINSTANCE_ADMIN_PASSWORD=ChangeMe_Zitadel1
ZITADEL_FIRSTINSTANCE_ADMIN_EMAIL=admin@saas-os.local

# --- Authentication HTTP flow (P2.2, saas_os/api/auth/config.py) ------------------
# OIDC_REDIRECT_URI is the one allowlisted callback URL registered with the
# provider -- the browser never chooses it. AUTH_POST_LOGIN_PATH is a fixed,
# same-origin absolute path the browser is sent to after login (no `next=`
# parameter is supported). AUTH_COOKIE_SECURE=false is accepted only outside
# ENVIRONMENT=production, for a local http://localhost development setup;
# production always sets the session cookie with the Secure attribute (P2.3
# provides the TLS termination). All four are non-secret settings.
#
# ADR-0024: OIDC_REDIRECT_URI is normally NOT set at all -- it is derived
# from PUBLIC_APP_ORIGIN below (`<origin>/auth/callback`), so the browser
# origin, the registered callback and the token-exchange redirect_uri are
# one value instead of three that must be kept in agreement by hand. Set it
# explicitly only for a deployment whose callback genuinely is not on the
# application origin (e.g. the pre-ADR-0024 two-origin local setup,
# `http://localhost:8000/auth/callback`, which still works exactly as
# before). Setting BOTH to values that disagree is a fail-closed
# configuration error, never silent precedence.
# OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
AUTH_POST_LOGIN_PATH=/
AUTH_COOKIE_NAME=saas_os_session
AUTH_COOKIE_SECURE=false
# TRUST_PROXY_HEADERS (P2.3): only `docker-compose.prod.yml` sets this to
# true. It tells saas_os/api/auth/routes.py's pre-login rate limiter to read the
# real client address from X-Forwarded-For (last hop only -- see that
# module's own docstring) instead of the direct TCP peer, which behind a
# reverse proxy is always the proxy itself. Leave false for local
# development and for any deployment not behind Caddy.
TRUST_PROXY_HEADERS=false

# --- Single-origin application runtime (ADR-0024, saas_os/infra/edge/) ------------
# PUBLIC_APP_ORIGIN is the one browser-visible origin the whole application
# is served on -- product frontend and SaaS-OS backend behind the same
# scheme/host/port. Scheme + host + optional port ONLY: no path, no query,
# no fragment, no credentials (rejected at startup otherwise), and https is
# required whenever ENVIRONMENT=production.
#
# It is NOT an internal container address. Internal services keep talking to
# each other over Compose DNS (`http://backend:8000`, `http://frontend:3000`);
# only this value is ever handed to a browser or an identity provider.
#
# Locally this is the `edge` service in docker-compose.yml, which routes
# /auth/*, /v1/*, /healthz and /readyz to `backend` and everything else to
# `frontend`. In docker-compose.prod.yml it is set for you, as
# https://${PUBLIC_DOMAIN} -- do not duplicate it in a production `.env.app`.
PUBLIC_APP_ORIGIN=http://localhost:8080
# Host port the local `edge` service publishes. Must match the port in
# PUBLIC_APP_ORIGIN above (the browser sees this one). Non-secret,
# local-development only -- never published in docker-compose.prod.yml.
SAAS_OS_EDGE_PORT=8080

# --- Production network perimeter (P2.3, docker-compose.prod.yml) ---------
# PUBLIC_DOMAIN is the one hostname Caddy (the production reverse proxy)
# requests an HTTPS certificate for and routes traffic to -- a deployment-
# specific value, never a real domain committed here. Caddy substitutes it
# into ./Caddyfile via its own container environment. Using "localhost"
# (as the production-validation script does) makes Caddy issue a local,
# self-signed certificate from its internal CA instead of attempting real
# ACME -- fine for deterministic testing, never a real deployment value.
PUBLIC_DOMAIN=app.example.com

# --- Production identity infrastructure (docs/ADR/0023-... Phase 3) -------
#
# ## SaaS-OS OIDC (already documented above, repeated here for context only
# ## -- do not duplicate these three values, they are the same variables):
# ## OIDC_ISSUER_URL should equal https://<IDENTITY_PUBLIC_DOMAIN> in
# ## production; the OIDC callback is derived from PUBLIC_APP_ORIGIN, which
# ## docker-compose.prod.yml itself sets to https://${PUBLIC_DOMAIN}
# ## (ADR-0024) -- do not set PUBLIC_APP_ORIGIN or OIDC_REDIRECT_URI in a
# ## production `.env` or `.env.app`; OIDC_CLIENT_ID is printed by
# ## `zitadel-bootstrap` (`docker compose -f docker-compose.prod.yml logs
# ## zitadel-bootstrap`) and goes in the production `.env.app`, same
# ## mechanism as Phase 1's local `.env`; OIDC_CLIENT_SECRET stays
# ## empty (public PKCE client, unchanged).
#
# ## Identity infrastructure (ZITADEL server + its own database -- never
# ## read by saas_os/core/identity; see docker-compose.prod.yml's own comments):
#
# IDENTITY_PUBLIC_DOMAIN is the operator-selected public hostname for the
# self-hosted ZITADEL instance -- an operator-controlled subdomain of the
# same registrable domain as PUBLIC_DOMAIN (never a third-party or
# ZITADEL-branded one), e.g. "id." + PUBLIC_DOMAIN's own domain. Never
# hardcoded into application code -- only into Caddy's own site-block
# selection and ZITADEL's ExternalDomain configuration
# (docker-compose.prod.yml). Verified against ZITADEL's own documentation:
# it has no supported arbitrary path-prefix deployment model, so this is a
# separate hostname, not a subpath of PUBLIC_DOMAIN -- see
# docs/ADR/0023-... for the full trade-off.
#
# ADR-0025 §1a -- IDENTITY_PROFILE selects one of two supported identity
# deployment profiles. It is pinned on first start (with both domains) by
# docker-compose.prod.yml's `identity-profile-guard`, which refuses to start
# on any later change: switching profile or domain would change the OIDC
# issuer and the WebAuthn/passkey/U2F RP ID, which is never an automatic
# migration.
#
#   fresh    -- NEW deployments (this template's value). ZITADEL, its OIDC
#               issuer (https://<PUBLIC_DOMAIN>), passkey/U2F RP ID and the
#               Login V2 UI (https://<PUBLIC_DOMAIN>/ui/v2/login) all live on
#               PUBLIC_DOMAIN. IDENTITY_PUBLIC_DOMAIN MUST equal
#               PUBLIC_DOMAIN, and OIDC_ISSUER_URL must be
#               https://<PUBLIC_DOMAIN>.
#   existing -- deployments created before ADR-0025, and the default when
#               IDENTITY_PROFILE is unset. Keep your existing
#               IDENTITY_PUBLIC_DOMAIN (e.g. id.example.com) and
#               OIDC_ISSUER_URL unchanged; ZITADEL stays on its own identity
#               domain with its existing issuer and RP ID.
IDENTITY_PROFILE=fresh
IDENTITY_PUBLIC_DOMAIN=app.example.com
# existing profile only: "true" opts the SaaS-OS application into Login V2
# at https://<IDENTITY_PUBLIC_DOMAIN>/ui/v2/login (same identity domain, so
# issuer and RP ID are unchanged); "false"/unset leaves the application's
# login UI as it is. Ignored by the fresh profile, which always uses Login
# V2. Reverting an application to Login V1 is a manual ZITADEL console
# change, not something the bootstrap does.
ZITADEL_LOGIN_V2_ENABLED=false
# Dedicated PostgreSQL credentials for ZITADEL's own database -- same
# variable names as the local Phase 1 topology (docker-compose.yml), a
# different deployment's own values. Never the SaaS-OS `db`/`APP_DB_USER`
# credentials -- ZITADEL manages its own schema/migrations independently
# (ADR-0023 S5); it must never join SaaS-OS's Alembic history.
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=changeme_zitadel_db_prod
ZITADEL_DB_NAME=zitadel
# Must be exactly 32 characters -- ZITADEL uses this to encrypt data at
# rest and refuses to start otherwise. A DIFFERENT value from
# ZITADEL_LOCAL_MASTERKEY above (Phase 1's own local-only key) -- a
# production ZITADEL database backup without its matching master key is
# NOT a valid disaster-recovery backup (docs/BACKUP-RESTORE.md). Changing
# or losing it after first startup makes the production instance's
# encrypted data permanently unreadable; there is no key-rotation
# mechanism in this repository. Generate with: openssl rand -hex 16
ZITADEL_MASTERKEY=changeme_32_char_production_key
# The initial admin console login (https://<IDENTITY_PUBLIC_DOMAIN>/ui/console)
# -- same variable names as Phase 1's local topology, a production
# deployment's own values. Not used by SaaS-OS's own OIDC flow.
ZITADEL_FIRSTINSTANCE_ADMIN_USERNAME=admin
# Must satisfy ZITADEL's default password complexity policy (upper + lower
# + digit, minimum length) -- verified empirically in Phase 1.
ZITADEL_FIRSTINSTANCE_ADMIN_PASSWORD=ChangeMe_Zitadel_Prod1
ZITADEL_FIRSTINSTANCE_ADMIN_EMAIL=admin@example.com
# Expiry of the IAM_OWNER bootstrap token ZITADEL creates for
# `zitadel-bootstrap` (RFC 3339). Required, no default: set it about 30
# days after the first deploy. Read once, when the instance is created.
# docs/RUNBOOKS.md, "Bootstrap token". Left empty on purpose: Compose
# refuses to start until you set it.
ZITADEL_BOOTSTRAP_PAT_EXPIRATION=
# Signs the Login V2 (`zitadel-login`) session cookie and its short-lived
# verification and IdP-link proofs (GHSA-jh92-5mrj-p2w2, fixed in ZITADEL
# v4.19.2). Required, no default: Compose refuses to start while it is unset
# or empty. Generate it from a cryptographically secure source, e.g.
#   openssl rand -base64 32
# Every value must be at least 32 characters (ZITADEL's own minimum; Login V2
# reports not ready otherwise), identical on every Login V2 replica. Supply
# it from your secret store into the deploying shell's environment rather
# than writing it here: this file is also loaded whole into backend, worker,
# frontend and proxy (`env_file:`). Never commit a real value. Rotation (a
# comma-separated list, new value first) is in docs/RUNBOOKS.md, "Login V2
# session-cookie secret". Not used by local development (docker-compose.yml
# runs no Login V2).
ZITADEL_SESSION_COOKIE_SECRET=
# ADR-0049: platform-admin routes require a multi-factor login at the
# identity provider; unset, this is true with ENVIRONMENT=production. Set it
# to false here or in the shell to turn it off. Enroll a second factor for
# every platform operator in ZITADEL first (docs/RUNBOOKS.md).
# PLATFORM_OPERATOR_REQUIRE_MFA=true
# Read by saas_os/infra/db/backup/orchestrator.py's --admin-database-url-var
# option (ADR-0023 Phase 3) -- a full admin connection string for
# ZITADEL's own database, distinct from SaaS-OS's own
# MIGRATIONS_DATABASE_URL, so the existing backup pipeline can back up
# zitadel-db without coupling it to SaaS-OS's own saas_os.infra.db.config module.
# See deploy/saas-os-zitadel-backup.service and docs/BACKUP-RESTORE.md.
ZITADEL_BACKUP_DATABASE_URL=postgresql://zitadel:changeme_zitadel_db_prod@zitadel-db:5432/zitadel  # pragma: allowlist secret

# --- Billing: Stripe (docs/ADR/0008-billing-provider.md) -------------------
# STRIPE_API_KEY is a test-mode secret key (sk_test_...) -- never a live
# key in this file. STRIPE_WEBHOOK_SECRET verifies the signature on
# incoming Stripe webhook events (saas_os/core/billing/stripe_provider.py::
# verify_stripe_webhook_signature) once a future Phase 8+ route receives
# them. Neither is required to run saas_os/core/billing against the fake/in-memory
# provider adapter used by the default test suite.
STRIPE_API_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
# PLATFORM_TENANT_ID designates which ordinary tenant is this deployment's
# platform tenant -- the owner of its own merchant account and platform
# plans (docs/ADR/0029-commercial-parties-and-billing-relationships.md,
# Decision 0.2; read by saas_os/core/tenancy/config.py). A UUID of an existing
# tenant, e.g. the one `python -m saas_os.api.tenant_bootstrap` reports. Not a
# secret. Unset/empty = no platform tenant designated: commercial billing
# operations that need one fail closed; nothing ever falls back to an
# arbitrary tenant.
PLATFORM_TENANT_ID=

# --- Email: transactional (P1.12; provider selection ADR-0057; Resend ADR-0058)
# EMAIL_PROVIDER selects the deployment's provider from a fixed, built-in
# list (saas_os/core/email/selection.py):
#   mailpit -- development only: the `mailpit` service in docker-compose.yml
#              (SMTP mailpit:1025 inside the Compose network; web UI
#              http://127.0.0.1:8025, bound to loopback). Refused unless
#              ENVIRONMENT is development or test -- never in production.
#              Never reads SMTP_* or the SMTP credentials.
#   smtp    -- any SMTP relay, configured by SMTP_* below.
#   resend  -- Resend's HTTP API (https://api.resend.com, fixed). Needs
#              RESEND_API_KEY (below) and a sender on a domain verified in
#              your Resend account. Reads no SMTP_* setting. Sends real
#              mail in every environment; use mailpit for development.
#   (unset) -- the pre-ADR-0057 behavior: smtp when SMTP_HOST is set,
#              otherwise email is simply not configured (an
#              EmailConfigurationError at send time, never at startup).
# Set explicitly, EMAIL_PROVIDER also makes the worker validate the email
# configuration at startup (no network call) and refuse to start if it is
# invalid. EMAIL_DEFAULT_SENDER is the From: address for every provider.
EMAIL_PROVIDER=mailpit
EMAIL_DEFAULT_SENDER=no-reply@example.com
EMAIL_TIMEOUT_SECONDS=10
# MAILPIT_SMTP_HOST=mailpit
# MAILPIT_SMTP_PORT=1025
#
# SMTP_HOST/SMTP_PORT/SMTP_TLS_MODE/SMTP_REQUIRE_TLS are plain, non-secret
# connection settings (saas_os/core/email/config.py). SMTP_TLS_MODE is
# starttls (default, port 587), implicit (TLS from the first byte, port 465)
# or none (plaintext). SMTP_USE_TLS=true/false is still accepted as an alias
# for starttls/none; setting both inconsistently is an error. Certificates
# are always verified; there is no setting to disable that. With
# ENVIRONMENT=production, SMTP_REQUIRE_TLS defaults to true and refuses
# SMTP_TLS_MODE=none; set SMTP_REQUIRE_TLS=false only for a deliberately
# plaintext relay (the same override DB_REQUIRE_TLS gives, ADR-0021).
# SMTP_USERNAME/SMTP_PASSWORD are read through the active SecretsProvider
# (saas_os/core/email/smtp_provider.py), same as every other secret in this
# file -- both set, or both unset for a relay that accepts unauthenticated
# connections.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
#
# RESEND_API_KEY is a secret, read through the active SecretsProvider
# (saas_os/core/email/resend_provider.py) only when EMAIL_PROVIDER=resend.
# Create a sending-access key in the Resend dashboard and keep it in your
# deployment's secret store; never commit it. EMAIL_TIMEOUT_SECONDS above
# bounds each Resend request in total.
RESEND_API_KEY=

# --- Webhook delivery (docs/ADR/0035-...) ---------------------------------
# Optional: the only ports a tenant's webhook URL may use, as a
# comma-separated list (443 for https and 80 for http when the URL names no
# port). Unset, any port on a public address is allowed. An empty or invalid
# value is a configuration error. Narrowing it also stops deliveries to
# existing subscriptions on other ports (dead-lettered, not retried).
# WEBHOOK_ALLOWED_PORTS=443

# --- Worker egress proxy (docs/ADR/0059-controlled-worker-egress.md) -----------
# Optional: the policy-enforcing CONNECT proxy the worker reaches the outside
# through, as http://<host>:<port> (no credentials, path or query). Set, webhook
# deliveries and the Resend provider connect only through it, to the address
# they validated, with TLS still verified on the original hostname; a proxy that
# refuses or cannot be reached is never bypassed. HTTP_PROXY and friends are
# still ignored. Unset: connections are direct. An invalid value stops the worker.
# EGRESS_PROXY_URL=http://egress-proxy:3128

# --- Backup / disaster recovery (P2.4, saas_os/infra/db/backup/) -------------------
# Non-secret pipeline configuration (saas_os/infra/db/backup/config.py). Targets are
# documented engineering goals, not enforced guarantees -- see
# docs/BACKUP-RESTORE.md's DR section. BACKUP_STAGING_DIR must be an
# absolute host path (the pipeline runs host-side via cron/systemd, not
# inside a container -- see deploy/saas-os-backup.service) with the same
# persistence property container volumes give the services below: real
# disk, not a container's writable layer.
BACKUP_STAGING_DIR=/var/lib/saas-os/backup-staging
BACKUP_OFF_SITE_ENABLED=false
BACKUP_RETENTION_COUNT=7
BACKUP_SCHEDULE_HOUR_UTC=3
BACKUP_RPO_HOURS=24
BACKUP_RTO_HOURS=4
BACKUP_MIN_FREE_BYTES=524288000
# Encryption (saas_os/infra/db/backup/encryption.py, via `age` -- age-encryption.org).
# BACKUP_ENCRYPTION_RECIPIENT is the *public* key (age1...) -- safe on the
# production host, used only to encrypt. It is REQUIRED whenever
# BACKUP_OFF_SITE_ENABLED=true: the pipeline refuses to run (and uploads
# nothing) if off-site is enabled and this is unset, empty, or not an
# age1... key -- an unencrypted artifact never leaves the host
# (docs/BACKUP-RESTORE.md, "Off-site storage"). BACKUP_ENCRYPTION_IDENTITY is the
# *private* key (AGE-SECRET-KEY-1...) -- generate with `age-keygen`, then
# keep it OFFLINE, away from the production host; it is only ever needed
# to decrypt during a restore, run from an operator's own machine. Both
# are read through the SecretsProvider (docs/ADR/0012-secrets-management.md)
# -- never required to run the default test suite.
BACKUP_ENCRYPTION_RECIPIENT=
BACKUP_ENCRYPTION_IDENTITY=
# Off-site storage (saas_os/infra/db/backup/destination.py) -- a generic
# S3-compatible bucket, only used when BACKUP_OFF_SITE_ENABLED=true. This
# bucket/credential must be dedicated to backups: least-privilege, no
# public/anonymous access, never the application's own database or
# provider credentials reused here.
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=
