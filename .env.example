# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored -- never commit it. No value below is a real secret.
# See docs/ADR/0012-secrets-management.md and docs/SECURITY.md section 4.

ENVIRONMENT=development

# --- Database (docs/ADR/0002-multi-tenancy-isolation-model.md) -----------
# Two distinct roles (docs/IMPLEMENTATION-ROADMAP.md Phase 3.1 security
# correction): POSTGRES_USER is the bootstrap/superuser role Postgres
# itself creates -- used only for migrations, never by the running
# application. APP_DB_USER is a restricted, NOSUPERUSER/NOBYPASSRLS role
# (created by infra/db/init/01-create-app-role.sh on first boot) that
# DATABASE_URL points at -- the role Row-Level Security enforcement
# depends on actually being non-superuser.
POSTGRES_USER=saas_os
POSTGRES_PASSWORD=changeme
POSTGRES_DB=saas_os
APP_DB_USER=saas_os_app
APP_DB_PASSWORD=changeme_app
DATABASE_URL=postgresql+psycopg://saas_os_app:changeme_app@db:5432/saas_os
MIGRATIONS_DATABASE_URL=postgresql+psycopg://saas_os:changeme@db:5432/saas_os
# DB_REQUIRE_TLS (S-05, docs/ADR/0021-database-redis-transport-encryption.md):
# optional. Defaults to true when ENVIRONMENT=production, false otherwise --
# leave unset here. When true, both DATABASE_URL/MIGRATIONS_DATABASE_URL
# must already specify sslmode=require (or stronger), or infra/db/config.py
# adds it automatically; a URL explicitly specifying a weaker sslmode
# (disable/allow/prefer) fails closed at startup instead of connecting in
# plaintext. This repository's own docker-compose.prod.yml does NOT set
# DB_REQUIRE_TLS=false -- it relies on this default; only set it here if a
# specific deployment has its own reviewed reason to opt out (see the ADR).
# DB_REQUIRE_TLS=true

# --- Redis / background jobs (docs/ADR/0007-...) --------------------------
# REDIS_URL is read through the active SecretsProvider by both the API and
# the worker (`python -m api.worker`, P2.1 -- the process that executes
# queued jobs). JOBS_MAX_TRIES / JOBS_RETRY_BACKOFF_BASE_SECONDS are the
# optional, non-secret retry-policy tunables (infra/jobs/config.py);
# omitted here, they default to 3 and 1.0.
REDIS_URL=redis://redis:6379/0
# REDIS_REQUIRE_TLS (S-05): the same DB_REQUIRE_TLS decision, for Redis --
# optional, defaults to true when ENVIRONMENT=production. When true,
# REDIS_URL must use the rediss:// scheme (not redis://); there is no
# in-URL parameter to add automatically for Redis, so a redis:// URL fails
# closed at startup instead of connecting in plaintext.
# REDIS_REQUIRE_TLS=true

# --- Identity: OIDC (docs/ADR/0005-...; docs/ADR/0023-... Phase 2) --------
# OIDC_ISSUER_URL / OIDC_CLIENT_ID are read through the SecretsProvider
# (core/identity/provider.py); the authorization/token/JWKS endpoints are
# discovered from the issuer's standard /.well-known/openid-configuration,
# never hard-coded. SaaS-OS identity reads only these provider-neutral
# names -- OIDC is the protocol boundary; the specific issuer these point
# at determines the actual provider. OIDC_CLIENT_SECRET is optional: leave
# it empty for a client registered as a *public* client (the login flow
# then relies on PKCE S256 alone, which is always required regardless);
# set it for a confidential client. It is only ever sent in the
# server-side token exchange (core/identity/oidc.py::exchange_authorization_code).
#
# Phase 2 cutover: the pre-Phase-2 ZITADEL_ISSUER_URL / ZITADEL_CLIENT_ID /
# ZITADEL_CLIENT_SECRET names are no longer read by core/identity at all --
# setting one of those alongside its OIDC_* replacement is a fail-closed
# configuration error (core/identity/provider.py::_reject_if_both_set),
# never silent precedence either way. ZITADEL server configuration
# (ZITADEL_MASTERKEY, ZITADEL_EXTERNALDOMAIN, etc., further down) is
# unrelated -- that configures the ZITADEL deployment itself, not
# SaaS-OS's own OIDC relying-party boundary.
#
# The default below points at the local, self-hosted ZITADEL that
# `docker compose up` now starts (docs/ADR/0023-..., "Local self-hosted
# ZITADEL" section further down) -- no ZITADEL Cloud account or other
# external provider is required for local development. `zitadel.localhost`
# (not plain `localhost`) is required: it's the one hostname reachable both
# from your browser (the reserved .localhost TLD resolves to 127.0.0.1 with
# no /etc/hosts entry needed) and from other containers (docker-compose.yml
# gives the `zitadel` service that exact same string as a network alias) --
# see the `zitadel` service's own comments for why that split matters.
# OIDC_CLIENT_ID is intentionally left blank: ZITADEL assigns it when
# the `zitadel-bootstrap` service creates the local OIDC application
# (deterministic name, but a provider-assigned numeric id), so it cannot be
# a fixed placeholder here -- run `docker compose logs zitadel-bootstrap`
# after first `docker compose up` and copy the printed
# `OIDC_CLIENT_ID=...` value into this file. Point these three at a
# different (e.g. cloud-hosted) OIDC-compliant provider instead if you
# don't want to use the local ZITADEL one.
OIDC_ISSUER_URL=http://zitadel.localhost:8081
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Local self-hosted ZITADEL (docs/ADR/0023-..., Phase 1) ----------------
# Configuration for the `zitadel`/`zitadel-db`/`zitadel-bootstrap` services
# in docker-compose.yml -- the local identity provider itself, not SaaS-OS's
# own consumer-side config above. Dedicated PostgreSQL database/credentials,
# never the SaaS-OS `db`/`APP_DB_USER` -- ZITADEL manages its own schema and
# must never be added to SaaS-OS's Alembic migration history (ADR-0023 S5).
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=changeme_zitadel_db
ZITADEL_DB_NAME=zitadel
# Must be exactly 32 characters -- ZITADEL uses this to encrypt data at
# rest and refuses to start otherwise. Changing or losing it after first
# startup makes that instance's encrypted data permanently unreadable (the
# instance is local/disposable, so for this environment that just means
# `docker compose down -v` and re-bootstrapping -- see docs/LOCAL-IDENTITY.md).
# Generate your own with: openssl rand -hex 16
ZITADEL_LOCAL_MASTERKEY=f9535fcdd55dbb8e22bc12e69834d575
# Host port the local ZITADEL is published on (developer/browser access and
# the OIDC authorization-redirect leg both need this reachable from the
# host, not just from other containers -- see docs/LOCAL-IDENTITY.md).
# Never published in docker-compose.prod.yml.
ZITADEL_LOCAL_PORT=8081
# The initial admin console login (http://localhost:8081/ui/console) --
# local-only, not used by SaaS-OS's own OIDC flow.
ZITADEL_FIRSTINSTANCE_ADMIN_USERNAME=admin
# Must satisfy ZITADEL's default password complexity policy (upper + lower
# + digit, minimum length) -- verified empirically: a plain lowercase
# placeholder like `changeme` is rejected outright (setup fails with
# `Errors.User.PasswordComplexityPolicy.HasUpper`) rather than accepted and
# flagged later.
ZITADEL_FIRSTINSTANCE_ADMIN_PASSWORD=ChangeMe_Zitadel1
ZITADEL_FIRSTINSTANCE_ADMIN_EMAIL=admin@saas-os.local

# --- Authentication HTTP flow (P2.2, api/auth/config.py) ------------------
# OIDC_REDIRECT_URI is the one allowlisted callback URL registered with the
# provider -- the browser never chooses it. AUTH_POST_LOGIN_PATH is a fixed,
# same-origin absolute path the browser is sent to after login (no `next=`
# parameter is supported). AUTH_COOKIE_SECURE=false is accepted only outside
# ENVIRONMENT=production, for a local http://localhost development setup;
# production always sets the session cookie with the Secure attribute (P2.3
# provides the TLS termination). All four are non-secret settings.
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
AUTH_POST_LOGIN_PATH=/
AUTH_COOKIE_NAME=saas_os_session
AUTH_COOKIE_SECURE=false
# TRUST_PROXY_HEADERS (P2.3): only `docker-compose.prod.yml` sets this to
# true. It tells api/auth/routes.py's pre-login rate limiter to read the
# real client address from X-Forwarded-For (last hop only -- see that
# module's own docstring) instead of the direct TCP peer, which behind a
# reverse proxy is always the proxy itself. Leave false for local
# development and for any deployment not behind Caddy.
TRUST_PROXY_HEADERS=false

# --- Production network perimeter (P2.3, docker-compose.prod.yml) ---------
# PUBLIC_DOMAIN is the one hostname Caddy (the production reverse proxy)
# requests an HTTPS certificate for and routes traffic to -- a deployment-
# specific value, never a real domain committed here. Caddy substitutes it
# into ./Caddyfile via its own container environment. Using "localhost"
# (as the production-validation script does) makes Caddy issue a local,
# self-signed certificate from its internal CA instead of attempting real
# ACME -- fine for deterministic testing, never a real deployment value.
PUBLIC_DOMAIN=app.example.com

# --- Billing: Stripe (docs/ADR/0008-billing-provider.md) -------------------
# STRIPE_API_KEY is a test-mode secret key (sk_test_...) -- never a live
# key in this file. STRIPE_WEBHOOK_SECRET verifies the signature on
# incoming Stripe webhook events (core/billing/stripe_provider.py::
# verify_stripe_webhook_signature) once a future Phase 8+ route receives
# them. Neither is required to run core/billing against the fake/in-memory
# provider adapter used by the default test suite.
STRIPE_API_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme

# --- Email: transactional (P1.12) -------------------------------------
# SMTP_HOST/SMTP_PORT/SMTP_USE_TLS/EMAIL_TIMEOUT_SECONDS/EMAIL_DEFAULT_SENDER
# are plain, non-secret connection settings (core/email/config.py) --
# SMTP_HOST is the only one without a default; email is simply not
# configured (core.email.errors.EmailConfigurationError at send time,
# never at startup) if it is unset. SMTP_USERNAME/SMTP_PASSWORD are read
# through the active SecretsProvider (core/email/smtp_provider.py), same
# as every other secret in this file -- both may be left unset together
# for a local development mail-catcher that accepts unauthenticated
# connections; neither is required to run core/email against the
# fake/in-memory provider adapter used by the default test suite.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USE_TLS=true
EMAIL_TIMEOUT_SECONDS=10
EMAIL_DEFAULT_SENDER=no-reply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Backup / disaster recovery (P2.4, infra/db/backup/) -------------------
# Non-secret pipeline configuration (infra/db/backup/config.py). Targets are
# documented engineering goals, not enforced guarantees -- see
# docs/BACKUP-RESTORE.md's DR section. BACKUP_STAGING_DIR must be an
# absolute host path (the pipeline runs host-side via cron/systemd, not
# inside a container -- see deploy/saas-os-backup.service) with the same
# persistence property container volumes give the services below: real
# disk, not a container's writable layer.
BACKUP_STAGING_DIR=/var/lib/saas-os/backup-staging
BACKUP_OFF_SITE_ENABLED=false
BACKUP_RETENTION_COUNT=7
BACKUP_SCHEDULE_HOUR_UTC=3
BACKUP_RPO_HOURS=24
BACKUP_RTO_HOURS=4
BACKUP_MIN_FREE_BYTES=524288000
# Encryption (infra/db/backup/encryption.py, via `age` -- age-encryption.org).
# BACKUP_ENCRYPTION_RECIPIENT is the *public* key (age1...) -- safe on the
# production host, used only to encrypt. It is REQUIRED whenever
# BACKUP_OFF_SITE_ENABLED=true: the pipeline refuses to run (and uploads
# nothing) if off-site is enabled and this is unset, empty, or not an
# age1... key -- an unencrypted artifact never leaves the host
# (docs/BACKUP-RESTORE.md, "Off-site storage"). BACKUP_ENCRYPTION_IDENTITY is the
# *private* key (AGE-SECRET-KEY-1...) -- generate with `age-keygen`, then
# keep it OFFLINE, away from the production host; it is only ever needed
# to decrypt during a restore, run from an operator's own machine. Both
# are read through the SecretsProvider (docs/ADR/0012-secrets-management.md)
# -- never required to run the default test suite.
BACKUP_ENCRYPTION_RECIPIENT=
BACKUP_ENCRYPTION_IDENTITY=
# Off-site storage (infra/db/backup/destination.py) -- a generic
# S3-compatible bucket, only used when BACKUP_OFF_SITE_ENABLED=true. This
# bucket/credential must be dedicated to backups: least-privilege, no
# public/anonymous access, never the application's own database or
# provider credentials reused here.
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=
