# Production application settings: copy this file to `.env.app` next to
# docker-compose.prod.yml and fill in real values. `.env.app` is gitignored
# (`.env.*`) -- never commit it. No value below is a real secret.
#
# docker-compose.prod.yml loads this file into `backend` and `worker` only
# (docs/ADR/0012-secrets-management.md, amendment of 2026-10-21). The host
# timers in deploy/ read it too. Every variable is described in
# `.env.example`, under the section named here.
#
# Never put identity-provider settings here: ZITADEL_MASTERKEY,
# ZITADEL_DB_PASSWORD, ZITADEL_SESSION_COOKIE_SECRET, the first-instance
# admin, ZITADEL_BACKUP_DATABASE_URL, PUBLIC_DOMAIN, IDENTITY_PUBLIC_DOMAIN
# and IDENTITY_PROFILE stay in `.env` (or the deploying shell), which
# Compose reads only to fill in `${...}` values in docker-compose.prod.yml.

# docker-compose.prod.yml sets ENVIRONMENT=production in both containers
# whatever this says; the host timers in deploy/ read this value.
ENVIRONMENT=production

# --- Database ---------------------------------------------------------------
# pragma: allowlist nextline secret
DATABASE_URL=postgresql+psycopg://saas_os_app:changeme_app@db:5432/saas_os
# pragma: allowlist nextline secret
MIGRATIONS_DATABASE_URL=postgresql+psycopg://saas_os:changeme@db:5432/saas_os
PLATFORM_CONFIG_DB_USER=saas_os_platform_config

# --- Redis / background jobs --------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Identity: OIDC -----------------------------------------------------------
OIDC_ISSUER_URL=http://zitadel.localhost:8081
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Authentication HTTP flow -------------------------------------------------
AUTH_POST_LOGIN_PATH=/
AUTH_COOKIE_NAME=saas_os_session

# --- Billing: Stripe ----------------------------------------------------------
STRIPE_API_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
PLATFORM_TENANT_ID=

# --- Email: transactional -----------------------------------------------------
# EMAIL_PROVIDER=mailpit is refused in production. The worker must be able
# to reach SMTP_HOST: docker-compose.prod.yml's worker network has no
# Internet route, so the deployment provides that connectivity (ADR-0057).
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
EMAIL_TIMEOUT_SECONDS=10
EMAIL_DEFAULT_SENDER=no-reply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
# To send through Resend's HTTP API instead (ADR-0058): set
# EMAIL_PROVIDER=resend, remove the SMTP_* lines, and provide RESEND_API_KEY
# through your secret store. EMAIL_DEFAULT_SENDER must be on a domain
# verified in Resend. The worker then needs outbound HTTPS to
# api.resend.com:443 directly; it ignores HTTP(S)_PROXY settings.
# RESEND_API_KEY=

# --- Backup / disaster recovery -----------------------------------------------
BACKUP_STAGING_DIR=/var/lib/saas-os/backup-staging
BACKUP_OFF_SITE_ENABLED=false
BACKUP_RETENTION_COUNT=7
BACKUP_SCHEDULE_HOUR_UTC=3
BACKUP_RPO_HOURS=24
BACKUP_RTO_HOURS=4
BACKUP_MIN_FREE_BYTES=524288000
BACKUP_ENCRYPTION_RECIPIENT=
