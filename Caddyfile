{
	# Non-secret: the ACME account contact email. Caddy substitutes {$VAR}
	# from this service's own container environment (docker-compose.prod.yml's
	# `env_file: .env`) -- never a hard-coded address.
	email admin@{$PUBLIC_DOMAIN}
}

# P2.3: the one production TLS/reverse-proxy boundary. PUBLIC_DOMAIN is a
# required, deployment-specific, non-secret environment variable (never a
# real domain committed here) -- see .env.example. Caddy's automatic HTTPS
# (ACME certificate issuance/renewal, TLS 1.2+, and an HTTP->HTTPS redirect
# on :80) is enabled by default for any real domain; when PUBLIC_DOMAIN is
# "localhost" (the production-validation script's own deterministic test
# case, never a real deployment value), Caddy automatically falls back to
# its internal, self-signed CA instead of attempting real ACME -- exactly
# the "local TLS using an ephemeral certificate" this checkpoint calls for,
# never a claim that live ACME/DNS issuance was exercised.
#
# ADR-0025 §1a: the site blocks themselves live in exactly ONE identity
# profile file, selected by IDENTITY_PROFILE (docker-compose.prod.yml passes
# it, defaulting to `existing`), imported at the bottom of this file:
#
#   deploy/caddy/identity-profile-fresh.caddyfile     -- canonical Topology A
#       for fresh deployments: ZITADEL + Login V2 (/ui/v2/login) on
#       PUBLIC_DOMAIN itself.
#   deploy/caddy/identity-profile-existing.caddyfile  -- compatibility
#       profile for existing deployments: ZITADEL stays on its own
#       IDENTITY_PUBLIC_DOMAIN (ADR-0023 §9), issuer and RP ID unchanged.
#
# An unknown profile makes the import fail, so Caddy refuses to start rather
# than guessing. deploy/check-identity-profile.sh enforces the matching
# domain rules before ZITADEL ever starts.

# Conservative security-header baseline (this checkpoint's own minimum). No
# CSP: this repository's Next.js frontend is an unstyled foundation page
# today (frontend/app/page.tsx) with no inline-script/style inventory to
# build a real policy against yet -- a restrictive CSP guessed now would very
# likely break the frontend the first time it grows, which this checkpoint
# explicitly warns against ("do not blindly add a restrictive CSP").
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# ADR-0025 §9 (Decision 6), mandatory invariant: provider (ZITADEL / Login V2)
# cookies MUST NOT reach SaaS-OS upstreams. Imported ONLY inside the `handle`
# blocks whose upstream is SaaS-OS (backend/frontend) on a host that also
# serves ZITADEL, ahead of their `reverse_proxy` -- never on the Login V2 or
# ZITADEL routes, which need them (Login V2's `sessions` cookie carries its
# ZITADEL sessions).
#
# Cookie names are the ZITADEL v4.19.0 set, verified in source:
#   ZITADEL server (cmd/defaults.yaml; `__Host-` prefixed when served over
#   HTTPS): zitadel.useragent, zitadel.login.csrf, zitadel.login.lang,
#   zitadel.quota.exhausted -- matched by the `(__Host-|__Secure-)?zitadel.*`
#   name pattern.
#   Login V2 (apps/login/src): sessions, fingerprintId, verificationCheck,
#   NEXT_LOCALE.
# Re-verify this list whenever the pinned ZITADEL/Login V2 version changes.
#
# Three `request_header` handlers, run in this order before the proxy: remove
# every provider cookie; tidy the leading "; " left when the first cookie was
# removed; then, if no Cookie value has anything left, remove the Cookie header
# itself, so SaaS-OS never sees an empty `Cookie:` header. The last one is a
# separate, matcher-guarded handler because a single header-operation set
# (e.g. `header_up`) always applies its regex replacements after its deletions
# (Caddy v2.11.4 modules/caddyhttp/headers/headers.go, HeaderOps.ApplyTo);
# a route's matcher is evaluated when the request reaches it, i.e. after the
# replacements above. `route` keeps the three in exactly this order (outside
# it, Caddy would sort the matcher-guarded one first).
(strip_provider_cookies) {
	route {
		request_header Cookie "(?:^|;\s*)(?:(?:__Host-|__Secure-)?zitadel\.[^=;]*|sessions|fingerprintId|verificationCheck|NEXT_LOCALE)=[^;]*" ""
		request_header Cookie "^;\s*" ""
		@no_cookie_left not header_regexp Cookie \S
		request_header @no_cookie_left -Cookie
	}
}

# Requests from browsers must never choose ZITADEL's instance/public host:
# ZITADEL and Login V2 read these headers ahead of Host (ZITADEL v4.19.0
# `InstanceHostHeaders`/`PublicHostHeaders` defaults, apps/login
# src/lib/server/host.ts). Stripping them leaves the standard, preserved Host
# header as the only source, as ZITADEL's own reverse-proxy guidance requires
# (self-hosting/manage/custom-domain.mdx).
(drop_client_zitadel_host_headers) {
	header_up -X-Zitadel-Instance-Host
	header_up -X-Zitadel-Public-Host
	header_up -X-Zitadel-Forward-Host
}

import /etc/caddy/identity-profiles/identity-profile-{$IDENTITY_PROFILE}.caddyfile
