# Audit identity phase P2 (owner decision D7) -- host-level trigger of the
# audit identity expiry report job. It only *enqueues* the job onto the
# existing ARQ/Redis queue; the already-running `worker` service executes it.
# The job reads and logs counts: it deletes nothing (expiry --apply is
# disabled, owner decision O9).
#
# Install:
#   sudo cp deploy/saas-os-audit-identity-report.service deploy/saas-os-audit-identity-report.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now saas-os-audit-identity-report.timer
#
# Adjust WorkingDirectory/EnvironmentFile and the Python interpreter path
# for the actual deployment host.

[Unit]
Description=saas-os audit identity expiry report trigger (audit identity P2)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/saas-os
EnvironmentFile=/opt/saas-os/.env.app
ExecStart=/opt/saas-os/.venv/bin/python -m saas_os.api.audit_identity_report_trigger
# A non-zero exit is a failed systemd unit, visible to `systemctl status`
# and `journalctl -u saas-os-audit-identity-report.service`.
TimeoutStartSec=60
