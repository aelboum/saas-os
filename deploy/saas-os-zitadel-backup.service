# ADR-0023 Phase 3 -- host-level backup scheduler unit for ZITADEL's own
# PostgreSQL database, mirroring deploy/saas-os-backup.service exactly
# (P2.4's pipeline reused as-is -- saas_os/infra/db/backup/orchestrator.py's own
# additive `--admin-database-url-var` option, not a second backup
# implementation). Deliberately NOT an application-runtime service, same
# reasoning as the SaaS backup unit: this must keep working even when the
# application stack itself is down.
#
# A ZITADEL database backup without its matching ZITADEL_MASTERKEY is NOT
# a valid disaster-recovery backup (docs/BACKUP-RESTORE.md) -- back up that
# key separately, through your own secret-management process; it is never
# part of this pipeline's own artifact.
#
# Install:
#   sudo cp deploy/saas-os-zitadel-backup.service deploy/saas-os-zitadel-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now saas-os-zitadel-backup.timer
#
# Adjust WorkingDirectory/EnvironmentFile/ExecStart's --container value and
# the Python interpreter path for the actual deployment host -- same as
# deploy/saas-os-backup.service's own instructions.

[Unit]
Description=saas-os ZITADEL PostgreSQL backup (ADR-0023 Phase 3)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/saas-os
# The pipeline's settings (BACKUP_*) come from `.env.app`; the ZITADEL
# admin URL is an identity-provider secret and stays in `.env`
# (docs/ADR/0012-secrets-management.md, amendment of 2026-10-21).
EnvironmentFile=/opt/saas-os/.env.app
EnvironmentFile=/opt/saas-os/.env
ExecStart=/opt/saas-os/.venv/bin/python -m saas_os.infra.db.backup.orchestrator run \
    --container saas-os-zitadel-db-1 \
    --admin-database-url-var ZITADEL_BACKUP_DATABASE_URL
TimeoutStartSec=1800
